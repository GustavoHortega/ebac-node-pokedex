
<link rel="stylesheet" type="text/css" href="/stylesheets/pokemon.css">

<div class="pokemon-show">
  <div class="row justify-content-center align-items-center">

    <div class="col-md-5">
      <div class="card pokemon-show-card">
        <img
          src="<%= pokemon.imagem %>"
          class="card-img-top"
          alt="Imagem do pokemon <%= pokemon.nome %>"
        >

        <div class="card-body">
          <%- include('partials/poke-info', {
            nome: pokemon.nome,
            altura: pokemon.altura,
            ataques: pokemon.ataques,
            peso: pokemon.peso,
            estatisticas: pokemon.estatisticas,
            jogos: pokemon.jogos,
          }) %>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="d-grid gap-3 button-battle-group">

        <% if (message !== undefined) { %>
          <h2 class="text-center highlight-color">
            <b>PARABÉNS!! POKÉMON CAPTURADO</b>
          </h2>
        <% } %>

        <a href="/pokemons" class="btn btn-warning">POKEDEX</a>
        <a href="/" class="btn btn-warning">HOME</a>

      </div>
    </div>

  </div>
</div>
